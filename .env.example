# Copiar este archivo a ".env" (en el mismo directorio) y completar
# con tus credenciales reales de DagsHub. ".env" esta en .gitignore:
# NUNCA se sube al repositorio ni se empaqueta en la imagen Docker.
#
#   cp .env.example .env
#   # despues editar .env con los valores reales

# URL del servidor MLflow remoto en DagsHub. Formato tipico:
# https://dagshub.com/<usuario>/<repo>.mlflow
MLFLOW_TRACKING_URI=https://dagshub.com/<usuario>/<repo>.mlflow

# Usuario de DagsHub.
MLFLOW_TRACKING_USERNAME=<tu-usuario-dagshub>

# Token de acceso de DagsHub (NO tu contraseña). Se genera en:
# DagsHub -> tu perfil -> Settings -> Tokens.
MLFLOW_TRACKING_PASSWORD=<tu-token-dagshub>

# Nombre del modelo tal como quedo registrado en el Model Registry
# en la Entrega 1.
MODEL_NAME=customer-churn-classifier

# Opcional: version puntual a cargar. Si se deja vacio, la API carga
# automaticamente la ultima version registrada.
MODEL_VERSION=

# Puerto del HOST donde se publica la API (el contenedor siempre
# escucha adentro en el 8000). Cambiar solo si el 8000 ya esta ocupado.
HOST_PORT=8000
